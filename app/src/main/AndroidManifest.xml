<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- MulticastLock 需要；部分 OEM 驱动按组播路径过滤 UDP 广播包 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 模型导入走 WorkManager 前台任务（dataSync），切后台/锁屏也不会被系统回收。
         work-runtime 的 AAR 已带入 FOREGROUND_SERVICE；API 34+ 起还需按类型单独申请，
         否则 startForeground 直接抛 SecurityException（本项目 targetSdk = 37）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- arenginesdk 硬编码带入，本 App 无外部存储读写；tools:node="remove" 让合并结果真正删除 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- 防御 arenginesdk 升级或换分发源后重新注入；当前依赖组合未声明该权限 -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />
    <!-- arenginesdk 带入的 normal 权限；自动发现走 NetworkInterface，不依赖它 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- 仅用于华为应用市场分发过滤，可删 -->
        <meta-data
            android:name="com.huawei.ar.engine"
            android:value="required" />

        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager 把它自己的 SystemForegroundService 声明在 AAR 里，但没有
             foregroundServiceType——API 34+ 要在 manifest 上显式声明类型，否则
             startForeground 抛 MissingForegroundServiceTypeException。
             这里用 tools:node="merge" 叠加类型：直接整体替换会丢掉 AAR 里的其他属性。
             dataSync 对应「本地文件导入/解压」，与 getForegroundInfo 传的类型一致。 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
