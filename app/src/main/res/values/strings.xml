    <string name="oss_lib_androidx">应用界面的基础</string>
    <string name="oss_lib_gson">负责 VTube Studio WebSocket 协议的 JSON 序列化与反序列化</string>
    <string name="oss_lib_arengine">人脸表情与头姿跟踪的核心能力来源。华为提供的专有 SDK，并非开源软件</string>
    <string name="oss_lib_kotlin">Kotlin 语言运行时与协程调度</string>
    <string name="oss_lib_okhttp">连接 VTube Studio 的 WebSocket 客户端与底层 I/O（Okio 随其分发），重连与心跳都由它承担</string>
    <string name="oss_lib_vtubestudio">本应用通过其公开的 WebSocket API 与之通信，不分发其任何代码</string>
    <string name="oss_lib_workmanager">模型导入的后台调度</string>
    <string name="oss_lib_purism">Live2D 模型的渲染核心，负责 .moc3 解析与参数求值</string>
    <string name="oss_lib_stb_image">原生渲染管线里的 PNG/JPEG 解码器，单文件实现，用于加载模型贴图</string>

