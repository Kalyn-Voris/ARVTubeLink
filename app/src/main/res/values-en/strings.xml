    <!-- One line per library explaining why this app needs it -->
    <string name="oss_lib_androidx">The UI foundation: AppCompat, Activity, Lifecycle and Compose UI / Material 3 build every screen in this app.</string>
    <string name="oss_lib_gson">Serializes and parses the JSON messages exchanged with VTube Studio over WebSocket.</string>
    <string name="oss_lib_arengine">Provides facial expression and head pose tracking. A proprietary SDK by Huawei — not open source.</string>
    <string name="oss_lib_kotlin">The Kotlin runtime and coroutine scheduler: reconnect backoff, the parameter probing pipeline, and the UI-side suspend functions.</string>
    <string name="oss_lib_okhttp">The WebSocket client used to talk to VTube Studio, plus its low-level I/O (Okio, bundled as an implementation dependency); it also handles reconnects and heartbeats.</string>
    <string name="oss_lib_vtubestudio">Interoperated with through its public WebSocket API; no code from it is bundled.</string>

